# Copy to .env and adjust:  cp .env.example .env

POSTGRES_USER=btm
POSTGRES_PASSWORD=btm
POSTGRES_DB=btm
# Port on your machine (5433 so it does not clash with a locally installed PostgreSQL)
DB_HOST_PORT=5433

# Identify yourself to the APIs (Digitraffic asks for this)
USER_AGENT=baltic-traffic-monitor/0.1 (+https://github.com/KristoferFangrat/baltic-traffic-monitor)

# AIS – Digitraffic, circle in kilometres
AIS_LAT=59.0
AIS_LON=19.5
AIS_RADIUS_KM=300
AIS_POLL_SECONDS=120
AIS_VESSEL_REFRESH_SECONDS=3600

# ADS-B – adsb.lol, circle in nautical miles (max 250)
ADSB_LAT=59.33
ADSB_LON=18.07
ADSB_RADIUS_NM=200
ADSB_POLL_SECONDS=60
# Look up origin/destination for new callsigns (adsb.lol routeset API)
ROUTE_POLL_SECONDS=120

# Delete raw positions older than this
RETENTION_DAYS=7
